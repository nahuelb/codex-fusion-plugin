{
  "description": "Advisory Fusion reminders for explicitly activated sessions.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/scripts/fusion.py\" hook",
            "timeout": 3,
            "additionalContextLimit": 300
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/scripts/fusion.py\" hook",
            "timeout": 3,
            "additionalContextLimit": 300
          }
        ],
        "matcher": "resume|compact"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$PLUGIN_ROOT/scripts/fusion.py\" hook",
            "timeout": 3,
            "additionalContextLimit": 300
          }
        ],
        "matcher": "apply_patch|Edit|Write"
      }
    ]
  }
}
